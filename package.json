{
  "name": "gerador-encartes",
  "productName": "Gerador de Encartes",
  "version": "0.2.0",
  "description": "Gerador de encartes promocionais offline - Soundindoor",
  "author": "Leanderson Santos",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@fontsource/alfa-slab-one": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/kaushan-script": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "konva": "10.8.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "vite": "8.3.4",
    "wait-on": "9.5.1",
    "xlsx": "0.18.5"
  },
  "build": {
    "appId": "br.soundindoor.encartes",
    "productName": "Gerador de Encartes",
    "directories": {
      "output": "instalador"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  }
}
